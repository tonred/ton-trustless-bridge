#include "imports/stdlib.fc";
#include "imports/constants.fc";

() set_lib(cell c, int x) impure asm "SETLIBCODE";


() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        ;; ignore all empty messages
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_msg_flags();

    if (flags & 1) {
        ;; ignore all bounced messages
        return ();
    }
    (_, slice owner) = load_msg_addr(get_data().begin_parse());
    slice sender_address = cs~load_msg_addr();
    throw_unless(error::not_owner, equal_slices_bits(owner, sender_address));

    cell lib = in_msg_body~load_ref();
    set_lib(lib, 2);
}




