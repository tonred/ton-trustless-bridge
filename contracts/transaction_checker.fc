#include "imports/constants.fc";
#include "imports/stdlib.fc";
#include "imports/utils.fc";
#include "imports/dict.fc";
#include "imports/shared.fc";

global slice ctx_lite_client_addr;
global int ctx_epochs_counter;
global cell ctx_epochs_cache;


() load_data() impure inline {
    var ds = get_data().begin_parse();

    ctx_lite_client_addr = ds~load_msg_addr();
    ctx_epochs_counter = ds~load_uint(16);
    ctx_epochs_cache = ds~load_dict();
}

() save_data() impure inline {
    set_data(
        begin_cell()
            .store_slice(ctx_lite_client_addr)
            .store_uint(ctx_epochs_counter, 16)
            .store_dict(ctx_epochs_cache)
            .end_cell()
    );
}

int set_new_epoch_data(int epoch_id, cell data) impure inline {
    if (ctx_epochs_counter >= tx_checker::max_past_epochs) {
        (int key, _, _) = ctx_epochs_cache~udict::delete_get_min(32);
        if (key >= epoch_id) {
            return false;
        }
    } else {
        ctx_epochs_counter += 1;
    }
    ctx_epochs_cache~udict_set_ref(32, epoch_id, data);
    save_data();
    return true;
}

() lite_client::query_epoch_data(int epoch_id, cell callback) impure inline {
    cell msg = begin_cell()
        .store_msg_flags_and_address_none(NON_BOUNCEABLE)
        .store_slice(ctx_lite_client_addr)
        .store_coins(0)
        .store_prefix_only_body()
        .store_op(op::get_epoch_data)
        .store_uint(epoch_id, 32)
        .store_maybe_ref(callback)
        .end_cell();

    send_raw_message(
        msg,
        SEND_MODE_CARRY_ALL_REMAINING_MESSAGE_VALUE | SEND_MODE_BOUNCE_ON_ACTION_FAIL
    );
}


() send_response(int op, int valid, slice address, int tx_hash) impure inline {
    cell msg = begin_cell()
        .store_msg_flags_and_address_none(NON_BOUNCEABLE)
        .store_slice(address)
        .store_coins(0)
        .store_prefix_only_body()
        .store_op(op)
        .store_bool(valid)
        .store_uint(tx_hash, 256)
        .end_cell();

    send_raw_message(
        msg,
        SEND_MODE_CARRY_ALL_REMAINING_MESSAGE_VALUE | SEND_MODE_BOUNCE_ON_ACTION_FAIL
    );
}

int get_prev_block_hash(cell block) inline {
    slice prev_ref = block.begin_parse().preload_ref().begin_parse().load_ref_1().begin_parse();
    prev_ref~skip_bits(96);
    return prev_ref.preload_uint(256);
}

cell check_shards_chain(int parent_hash, cell chain) inline {
    slice cs = chain.begin_parse();
    int refs = cs.slice_refs();
    int has_child = refs == 4;
    cell shard_block = null();
    repeat ((has_child ? 3 : refs) - 1) {
        shard_block = cs~load_ref();
        throw_unless(error::invalid_sc_proof, parent_hash == shard_block.cell_hash_0());
        parent_hash = get_prev_block_hash(shard_block);
    }
    shard_block = cs~load_ref();
    throw_unless(error::invalid_sc_proof, parent_hash == shard_block.cell_hash_0());
    if (has_child) {
        return check_shards_chain(get_prev_block_hash(shard_block), cs~load_ref());
    }
    return shard_block;
}

(int) load_shard_block_hash(cell mc_block) impure inline {
    cell mc_block_extra = mc_block.begin_parse()
        .load_ref_3().begin_parse()
        .load_ref_3();
    cell shards_hashes = mc_block_extra.begin_parse().preload_ref();
    (slice wc, _) = shards_hashes.idict_get?(32, 0);
    slice shard_descr = bintree_search(wc~load_ref_slice());
    shard_descr~skip_bits(196); ;; 4 + 32 + 32 + 64 + 64
    return shard_descr~load_uint(256);
}

(int) gen_utime_from_block(cell block) inline {
    slice cs = block.begin_parse().preload_ref().begin_parse();
    cs~skip_bits(248); ;; 70 + 10 + 32 + 136
    return cs~load_uint(32);
}

() check_transaction(cell proof_chain_data, cell tx_proof_data, slice sender_address) impure inline {
    slice proof_chain = proof_chain_data.begin_parse();
    slice tx_proof = tx_proof_data.begin_parse();

    int file_hash = proof_chain~load_uint(256);
    int epoch_id = proof_chain~load_uint(32);

    cell mc_block = proof_chain~load_ref();
    int mc_block_hash = mc_block.cell_hash_0();

    cell signatures = proof_chain~load_ref();

    cell shard_block = null();
    if proof_chain.slice_refs() > 0 {
        shard_block = proof_chain~load_ref();
        int root_shard_block_hash = shard_block.cell_hash_0();
        if proof_chain.slice_refs() > 0 {
            shard_block = check_shards_chain(get_prev_block_hash(shard_block), proof_chain~load_ref());
        }
        throw_unless(error::sc_block_not_in_mc_state, root_shard_block_hash == load_shard_block_hash(mc_block));
    }

    slice account_block = tx_proof~load_bits(256);
    slice tx_lt = tx_proof~load_bits(64);
    int tx_hash = tx_proof~load_uint(256);
    tx_proof.end_parse();

    tx_checker::lookup_tx_in_block(shard_block.null?() ? mc_block : shard_block, tx_hash, tx_lt, account_block);

    (cell epoch_data, int found) = ctx_epochs_cache.udict_get_ref?(32, epoch_id);
    ifnot (found) {
        cell callback = begin_cell()
            .store_uint(mc_block_hash, 256)
            .store_uint(file_hash, 256)
            .store_ref(signatures)
            .store_ref(begin_cell().store_slice(sender_address).store_uint(tx_hash, 256).end_cell())
            .end_cell();

        lite_client::query_epoch_data(epoch_id, callback);
        return ();
    }
    var (epoch_since, epoch_until, _, cutoff_weight, validators_set) = parse_epoch_data(epoch_data);

    int mc_block_gen_utime = gen_utime_from_block(mc_block);
    throw_unless(
        error::invalid_epoch_for_block,
        (mc_block_gen_utime >= epoch_since) & (mc_block_gen_utime <= (epoch_until + 172800)) ;; 2 days
    );

    ;; Verify the block signatures using the current validators set.
    verify_block_signatures(
        signatures,
        validators_set,
        mc_block_hash,
        file_hash,
        cutoff_weight
    );
    send_response(response::transaction_checked, true, sender_address, tx_hash);
}

() save_epoch_and_check_block(int epoch_id, cell epoch_data, cell callback) impure inline {
    int valid = epoch_data.null?() ? false : set_new_epoch_data(epoch_id, epoch_data);
    ifnot (valid) {
        slice child_callback = callback.begin_parse().load_ref_1().begin_parse();
        slice sender_address = child_callback~load_msg_addr();
        int tx_hash = child_callback~load_uint(256);
        send_response(response::transaction_checked, false, sender_address, tx_hash);
        return ();
    }

    ifnot (callback.null?()) {
        slice callback = callback.begin_parse();
        int block_hash = callback~load_uint(256);
        int file_hash = callback~load_uint(256);
        cell signatures = callback~load_ref();
        slice child_callback = callback~load_ref_slice();
        var (
            _, ;; epoch_since,
            _, ;; epoch_until,
            _, ;; main_validators,
            cutoff_weight,
            validators_set
        ) = parse_epoch_data(epoch_data);


        ;; Verify the block signatures using validators set.
        verify_block_signatures(
            signatures,
            validators_set,
            block_hash,
            file_hash,
            cutoff_weight
        );
        slice sender_address = child_callback~load_msg_addr();
        int tx_hash = child_callback~load_uint(256);
        send_response(response::transaction_checked, true, sender_address, tx_hash);
    }
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        ;; ignore all empty messages
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_msg_flags();

    if (flags & 1) {
        ;; ignore all bounced messages
        return ();
    }

    load_data();

    int op = in_msg_body~load_uint(32);

    if (op == op::check_transaction) {
        (cell proof_chain_data, _) = extract_merkle_proof(in_msg_body~load_ref());
        cell tx_proof_data = in_msg_body~load_ref();
        slice sender_address = cs~load_msg_addr();

        check_transaction(proof_chain_data, tx_proof_data, sender_address);
        return ();
    }
    if (op == op::sync_epoch) {
        int epoch_id = in_msg_body~load_uint(32);
        lite_client::query_epoch_data(epoch_id, null());
        return ();
    }

    if (op == response::epoch_data) {
        throw_unless(error::not_lite_client, equal_slices_bits(cs~load_msg_addr(), ctx_lite_client_addr));
        int epoch_id = in_msg_body~load_uint(32);
        cell epoch_data = in_msg_body~load_maybe_ref();
        cell callback = in_msg_body~load_maybe_ref();
        save_epoch_and_check_block(epoch_id, epoch_data, callback);
        return ();
    }


    throw(0xffff);
}
