#include "stdlib.fc";
#include "utils.fc";
#include "dict.fc";

const int tl::simplex_data_to_sign = 0xf83de3a8;
const int tl::finalize_vote = 0x05e1a740;
const int tl::candidate_hash_ordinary = 0xdcbcf9e8;
const int tl::candidate_hash_empty = 0x33d9b472;
const int tl::candidate_parent_some = 0xf19a4b1a;
const int tl::candidate_parent_none = 0xa9cccb22;
const int tl::candidate_id = 0x3fcd91b6;

const int FULL_SHARD = 1 << 63;

int slice_hash2(slice s1, slice s2) inline asm "2 PUSHINT HASHEXT_SHA256";

(int, int, builder) begin_hash_candidate(slice candidate) inline {
    int candidate_type = candidate~load_uint(4);
    int seqno = candidate~load_uint(32);

    if (candidate_type == 0) {
        slice collated_file_hash = candidate~load_bits(256);

        builder to_hash_high = begin_cell().store_slice(collated_file_hash);

        if (candidate~load_int(1)) {
            int slot = candidate~load_uint(32);
            slice candidate_hash = candidate~load_bits(256);
            to_hash_high = to_hash_high
                .store_uint(tl::candidate_parent_some, 32)
                .store_uint(tl::candidate_id, 32)
                .store_uint(slot, 32)
                .store_slice(candidate_hash);
        } else {
            to_hash_high = to_hash_high.store_uint(tl::candidate_parent_none, 32);
        }

        candidate.end_parse();
        return (tl::candidate_hash_ordinary, seqno, to_hash_high);
    } else {
        int slot = candidate~load_uint(32);
        slice candidate_hash = candidate~load_bits(256);
        candidate.end_parse();
        builder to_hash_high = begin_cell()
            .store_uint(tl::candidate_id, 32)
            .store_uint(slot, 32)
            .store_slice(candidate_hash);

        return (tl::candidate_hash_empty, seqno, to_hash_high);
    }
}

int hash_candidate(slice candidate, int root_hash, int file_hash) inline {
    (int tag, int seqno, builder to_hash_high) = begin_hash_candidate(candidate);

    slice to_hash_low = begin_cell()
        .store_uint(tag, 32)
        .store_int(MASTERCHAIN, 32) ;; tonNode.blockIdExt.workchain
        .store_uint(FULL_SHARD, 64) ;; tonNode.blockIdExt.shard
        .store_int(seqno, 32)       ;; tonNode.blockIdExt.seqno
        .store_uint(root_hash, 256) ;; tonNode.blockIdExt.root_hash
        .store_uint(file_hash, 256) ;; tonNode.blockIdExt.file_hash
        .end_cell()
        .begin_parse();

    return slice_hash2(to_hash_low, to_hash_high.end_cell().begin_parse());
}

(cell, slice) parse_signatures_data(slice signatures_data, int root_hash, int file_hash) inline {
    cell signatures = signatures_data~load_ref();

    int slot = signatures_data~load_uint(32);
    slice session_id = signatures_data~load_bits(256);

    cell candidate = signatures_data~load_ref();
    signatures_data.end_parse();

    int candidate_hash = hash_candidate(candidate.begin_parse(), root_hash, file_hash);

    slice to_sign = begin_cell()
        .store_uint(tl::simplex_data_to_sign, 32)
        .store_slice(session_id)
        .store_uint(44, 8) ;; data len (1 byte)
        .store_uint(tl::finalize_vote, 32)
        .store_uint(tl::candidate_id, 32)
        .store_uint(slot, 32)
        .store_uint(candidate_hash, 256)
        .store_int(0, 24) ;; padding (3 bytes)
        .end_cell()
        .begin_parse();

    return (signatures, to_sign);
}

;;; Verifies that the signatures of a block have sufficient collective weight >= `cutoff_weight`
;;; Iterates over the signatures and checks each one against the public key from the validators dict.
;;; Throws an error if signatures are insufficient or invalid.
() verify_block_signatures(cell signatures, cell validators, int root_hash, int file_hash, int cutoff_weight) impure inline {
    ;; Prepare the data to be signed (ordinary)
    ;; slice hash = begin_cell()
    ;;     .store_uint(0x706e0bc5, 32)
    ;;     .store_uint(root_hash, 256)
    ;;     .store_uint(file_hash, 256)
    ;;     .end_cell()
    ;;     .begin_parse();

    ;; Prepare the data to be signed (simplex)
    (signatures, slice hash) = parse_signatures_data(signatures.begin_parse(), root_hash, file_hash);

    int weight = 0;
    int key = 0;
    do {
        (key, slice signature, int stop_flag) = signatures.udict_get_nexteq?(16, key);

        ;; If no more signatures are available, but we haven't reached cutoff weight, throw an error
        throw_unless(error::not_enough_signatures, stop_flag);

        ;; Retrieve validator data (public key + weight)
        slice data = validators.udict_get(16, key);
        int pubkey = data~load_uint(256);

        ;; Check signature validity
        throw_unless(
            error::invalid_signature,
            check_data_signature_raw(hash, signature, pubkey)
            ;; check_data_signature(hash, signature, pubkey)
        );

        weight += data.preload_uint(64);
        key += 1;

    } until (weight >= cutoff_weight);
}


;;; Loads epoch data
;;; returns:
;;; `epoch_since`:uint32       - starting timestamp of the validator epoch
;;; `epoch_until`:uint32       - ending timestamp of the validator epoch
;;; `main_validators`:uint16   - number of validators for masterchain in epoch.
;;; `cutoff_weight`:grams      - minimum total validators weight needed for block ation.
;;; `validators_set`:cell      - validators set with pubkey and weight, sorted by weight
var parse_epoch_data(cell data) impure inline {
    slice cs = data.begin_parse();
    int epoch_since = cs~load_uint(32);
    int epoch_until = cs~load_uint(32);
    int main_validators = cs~load_uint(16);
    int cutoff_weight = cs~load_grams();
    cell validators_set = cs~load_ref();

    return (
        epoch_since,
        epoch_until,
        main_validators,
        cutoff_weight,
        validators_set
    );
}

;;; store epoch data into cell
cell store_epoch_data(
    int epoch_since,
    int epoch_until,
    int main_validators,
    int cutoff_weight,
    cell validators_set
) impure inline {
    builder b = begin_cell()
        .store_uint(epoch_since, 32)
        .store_uint(epoch_until, 32)
        .store_uint(main_validators, 16)
        .store_grams(cutoff_weight)
        .store_ref(validators_set);
    return b.end_cell();
}

() tx_checker::lookup_tx_in_block(cell block, int tx_id, int lt, slice account_block_id) impure inline {
    cell account_blocks = block.begin_parse()
        .load_ref_3()
        .begin_parse()
        .load_ref_2()
        .begin_parse()
        .preload_ref();

    (slice account_block, _) = account_blocks
        .begin_parse()
        .aug_dict_get(account_block_id);
    account_block~skip_currency_collection();
    account_block~skip_bits(4 + 256);
    (slice tx, int found) = account_block.aug_dict_get(begin_cell().store_uint(lt, 64).end_cell().begin_parse());
    throw_unless(error::key_not_found, found);
    int hash = tx~load_ref().cell_hash_0();
    throw_unless(error::invalid_tx_hash, hash == tx_id);
}
